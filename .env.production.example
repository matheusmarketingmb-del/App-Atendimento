NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/app_whats?schema=public
SESSION_SECRET=CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
VERIFY_TOKEN=TOKEN_DE_VERIFICACAO_DO_WEBHOOK
WHATSAPP_TOKEN=TOKEN_DA_WHATSAPP_CLOUD_API
PHONE_NUMBER_ID=ID_DO_NUMERO_META
WHATSAPP_BUSINESS_ACCOUNT_ID=ID_DA_CONTA_WHATSAPP_BUSINESS
GRAPH_VERSION=vXX.X
META_APP_ID=
META_APP_SECRET=APP_SECRET_DA_META
INTEGRATION_API_SECRET=CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# Cofre de credenciais de IA (opcional). Sem esta chave, o app inicia e o
# motor local continua funcionando, mas o painel não salva credenciais.
AI_SECRETS_ENCRYPTION_KEY=CHAVE_DE_32_BYTES_EM_HEX_OU_BASE64
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000

# Web Push (opcional). Sem essas duas, notificações com o app fechado ficam desativadas sem quebrar o app.
VAPID_PUBLIC_KEY=CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=CHAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:suporte@seudominio.com

# Cofre e OAuth dos canais
INTEGRATION_ENCRYPTION_KEY=CHAVE_DE_32_BYTES_EM_HEX_OU_BASE64
META_OAUTH_REDIRECT_URI=https://atendimento.mibrobrasil.com.br/oauth-callback.html
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://atendimento.mibrobrasil.com.br/oauth-callback.html
GMAIL_SYNC_INTERVAL_MS=30000
# Só importa e-mails do Gmail com este marcador, na forma da busca do Gmail
# (clique no marcador e copie o que vem após "label:"). Vazio = INBOX + SPAM.
GMAIL_SYNC_LABEL=shopify--site-mibro-
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://atendimento.mibrobrasil.com.br/oauth-callback.html
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_OAUTH_REDIRECT_URI=https://atendimento.mibrobrasil.com.br/oauth-callback.html

AMAZON_SPAPI_APPLICATION_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_OAUTH_REDIRECT_URI=https://atendimento.mibrobrasil.com.br/oauth-callback.html
AMAZON_SELLER_CENTRAL_URL=https://sellercentral.amazon.com.br
