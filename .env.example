PORT=3000
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/app_whats?schema=public"
WHATSAPP_TOKEN=
META_APP_ID=
META_APP_SECRET=
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
VERIFY_TOKEN=
GRAPH_VERSION=vXX.X
SESSION_SECRET=gere-uma-chave-aleatoria-longa
INTEGRATION_API_SECRET=gere-outra-chave-aleatoria-longa
NODE_ENV=development

# Canais de atendimento (omnichannel) — painel "Integrações". WhatsApp/Meta
# continua usando só as variáveis acima; o que segue é só para as contas
# NOVAS (Instagram, Facebook, e-mail, Mercado Livre, etc.), configuradas por
# conta/página dentro do próprio painel (nunca aqui em texto puro).
#
# Chave mestra (AES-256-GCM) que cifra as credenciais de ChannelAccount
# (accessToken/refreshToken/pageAccessToken/etc.) antes de gravar no banco.
# Gere com: openssl rand -hex 32 (ou base64, 32 bytes).
INTEGRATION_ENCRYPTION_KEY=gere-uma-chave-de-32-bytes-hex-ou-base64
#
# Instagram Direct/Comentários e Facebook Messenger/Comentários reaproveitam
# o MESMO app Meta do WhatsApp (GRAPH_VERSION/META_APP_SECRET acima) — não
# precisam de novas variáveis de app. Cada ChannelAccount recebe, pelo
# painel, config.pageId + secrets.pageAccessToken (Facebook) ou
# config.igUserId + secrets.igAccessToken (Instagram), obtidos manualmente
# no Meta Business Suite/Graph API Explorer (ver docs/integrations/architecture.md).
#
# OAuth de e-mail (Gmail/Microsoft 365) e Google Reviews — usados quando o
# Master clica em "Conectar via OAuth" na conta do canal.
META_OAUTH_REDIRECT_URI=https://seu-dominio/oauth-callback.html
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://seu-dominio/oauth-callback.html
GMAIL_SYNC_INTERVAL_MS=30000
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://seu-dominio/oauth-callback.html
#
# OAuth do Mercado Livre (app próprio, criado em developers.mercadolivre.com.br).
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_OAUTH_REDIRECT_URI=https://seu-dominio/oauth-callback.html

# Web Push (notificações PWA com app fechado). Gere o par com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY é exposta ao navegador (não é segredo); VAPID_PRIVATE_KEY nunca deve sair do servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com

# Motor de IA / Fallback externo (opcional). Sem nenhuma credencial
# configurada (nem aqui, nem pelo painel), o Bot continua funcionando
# normalmente só com o motor local. Escolhido por Bot na tela de
# configuração ("Provider de IA externa" + modelo); só é chamado se "IA
# externa como fallback" estiver ligado E a confiança local ficar abaixo do
# limiar configurado.
#
# RECOMENDADO: cadastre/troque as chaves de GEMINI/ANTHROPIC/OPENAI direto
# pelo painel (aba "Chaves de IA" em /bots, só Admin) — nunca precisa editar
# env na VPS depois disso. As variáveis abaixo continuam funcionando como
# compatibilidade (usadas só quando não houver chave salva pelo painel para
# aquele provider).
AI_SECRETS_ENCRYPTION_KEY=gere-uma-chave-de-32-bytes-hex-ou-base64
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000

# IA LOCAL (LOCAL_QWEN — Ollama rodando fora da VPS, tipicamente no PC do
# operador via Tailscale). Host/porta/modelo/timeout/concorrência ficam em
# LocalAiProviderSettings (painel, GLOBAL — nunca por Bot), não em env; as
# duas variáveis abaixo só ajustam a fila local (nunca o endereço da IA).
LOCAL_AI_QUEUE_MAX=10
LOCAL_AI_QUEUE_TIMEOUT_MS=20000

AMAZON_SPAPI_APPLICATION_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_OAUTH_REDIRECT_URI=https://atendimento.mibrobrasil.com.br/oauth-callback.html
AMAZON_SELLER_CENTRAL_URL=https://sellercentral.amazon.com.br
